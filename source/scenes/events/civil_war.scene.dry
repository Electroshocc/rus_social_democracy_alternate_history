title: Гражданская война
audio: music/communist/A_las_barricadas.ogg
on-arrival: {!
Q.rb_strength = Math.round(Q.rb_strength);
Q.sh_strength = Math.round(Q.sh_strength);
Q.sa_strength = Math.round(Q.sa_strength);
// re-calculate dissent, in case we transitioned from, say, the KPD support that raised reformist dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;
var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;

Q.dissent = 0.01*total_dissent/total_strength;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

Q.civil_war_seen = 1;

// our allies
Q.total_power = 0;
// TODO:  lower reichsbanner strength if the party's popularity is very low.
Q.rb_power = Q.rb_strength*Q.rb_militancy;
if (Q.dissent > 0.15) {
    Q.rb_power *= (1 - Q.dissent/1.5);
}
Q.total_power += Q.rb_power;
Q.prussian_police_power = Q.prussian_police_strength*Q.prussian_police_militancy*Q.prussian_police_loyalty;
if (Q.spd_prussia) {
    Q.total_power += Q.prussian_police_power;
}
if (Q.reichswehr_loyalty < 0) {
    Q.reichswehr_loyalty = 0;
}
Q.loyal_reichswehr_power = Q.reichswehr_strength*Q.reichswehr_militancy*Q.reichswehr_loyalty;
if (Q.spd_in_government && Q.chancellor_party == "SPD") {
    Q.total_power += Q.loyal_reichswehr_power;
} else {
    Q.total_power += Q.loyal_reichswehr_power/4;
}
Q.rfb_power = Q.rfb_strength*Q.rfb_militancy;
if (Q.kpd_relation >= 60) {
    Q.total_power += Q.rfb_power;
} else if (Q.kpd_relation >= 45) {
    Q.total_power += Q.rfb_power*0.5;
}
// general strike strength
// maximum (given 25 labor strength) is 400
// use normalized workers_spd instead of labor_strength?
Q.normalized_workers_spd = 100*Q.workers_spd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z);
Q.normalized_workers_kpd = 100*Q.workers_kpd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z);
Q.normalized_workers_total = Q.normalized_workers_spd;
if (Q.kpd_relation >= 60) {
    Q.normalized_workers_total += Q.normalized_workers_kpd;
} else if (Q.kpd_relation >= 45) {
    Q.normalized_workers_total += Q.normalized_workers_kpd*0.5;
}
Q.total_power += (2 - Q.labor_dissent/100)*Q.normalized_workers_total*(2 - Q.unemployed/100)*2.5;
console.log("Supporter strength:", Q.total_power);

// our enemies
Q.enemy_power = 0;
Q.sa_power = Q.sa_strength*Q.sa_militancy;
Q.enemy_power += Q.sa_power;
Q.sh_power = Q.sh_strength*Q.sh_militancy;
Q.enemy_power += Q.sh_power;
Q.hostile_reichswehr_power = Q.reichswehr_strength*Q.reichswehr_militancy*(1-Q.reichswehr_loyalty);
Q.enemy_power += Q.hostile_reichswehr_power;
console.log("Enemy strength:", Q.enemy_power);

if (Q.total_power > Q.enemy_power*1.1) {
    Q.republic_victory = 1;
} else if (Q.total_power/Q.enemy_power >= 0.6) {
    Q.long_war = 1;
} else {
    Q.total_defeat = 1;
}

Q.is_favorable = 0;
if (Q.total_power >= Q.enemy_power*0.95) {
    Q.is_favorable = 1;
}
!}
go-to: war_menu

= Расклад сил

Наши противники - националистский Штальхельм, в составе которого [+ sh_strength +] тысяч солдат и нацистская СА с [+ sa_strength +] тысячами солдат. Лояльность рейхсвера и его [+ reichswehr_strength +] тысяч солдат и [+ prussian_police_strength +] тысяч полицейских прусского отдела неясна.

[? if chancellor_party == "KPD" or president == "Thälmann" : РФБ, военизированная группировка коммунистов, ведёт бой. Мы помогаем им чем можем. ?]

На нашей стороне [+ rb_strength +] тысяч участников Рейхсбаннера. [? if dissent > 0.15 and dissent <= 0.25: Тем не менее из-за раздора в партии некоторые участники не решают выступить на нашей стороне. ?][? if dissent > 0.25 and dissent < 0.5: Он ослаблен раздором в партии, многие не решили выступить за нас. ?][? if dissent >= 0.5: Он значительно ослаблен раздором в партии, значительная часть участников отказывается от битвы. ?]

[? if rb_militancy < 0.25 : К сожалению, Рейхсбаннер недостаточно натренирован и укомплектован для борьбы с военнизированными группировками. ?][? if rb_militancy >= 0.25 and rb_militancy < 0.5 : Мы уделили некоторые ресурсы на тренировку и подгтовку Рейхсбаннера. Надеемся, что это поможет. ?][? if rb_militancy >= 0.5 : Мы потратили значительную чать наших доходов на подготовку и преобразование Рейхсбаннера в достойную силу. Надеемся, что они победят. ?]

Что ещё мы можем предпринять?

# note: many scenarios lead to civil war. This calculates the array of forces, and the possible outcomes.

@war_menu

- @rw_help: Призвать Рейхсвер на нашу сторону.
- @kpd_help: Попросить поддержку у коммунистов.
- @general_strike: Объявить всеобщую забастовку!
- @loyal_police: Призвать лояльную часть полиции.
- @war_outcome: Итак, битва...

@rw_help
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

Мы призвали Рейхсвер не сражаться с нами и отказаться от убийства своих сограждан. [? if reichswehr_loyalty < 0.2 : К сожалению, не многие в армии согласились; Рейхсвер проигнорировал наше воззвание. ?][? if reichswehr_loyalty >= 0.2 and reichswehr_loyalty < 0.4 : Некоторые офицеры и солдаты послушали нас и отказались сражаться. Некоторые из них даже перешли на нашу сторону. ?][? if reichswehr_loyalty >= 0.4 and reichswehr_loyalty < 0.6 : Рейхсвер разделён. Почти равные части приняли решение сражаться либо за нас. либо против нас. ?][? if reichswehr_loyalty >= 0.6 : К нашему удивлению, большинство в Рейхсвере поддерживает нас! Наши реформы не прошли даром. ?]

@kpd_help
max-visits: 1
view-if: chancellor_party != "KPD" and president != "Thälmann" 
go-to: war_menu
on-arrival: war_choices += 1

В РФБ состоит [+ rfb_strength +] тысяч солдат, не считая симпатизирующих коммунистам среди рабочих.

[? if kpd_relation >= 60 : КПГ полностью нас поддерживает, учитывая наши отношения. ?][? if kpd_relation < 60 and kpd_relation >= 45 : Благодаря нашей дружбе большинство среди коммунистов нас поддерживает. ?][? if kpd_relation < 45 : КПГ не поддерживает нас. ?]

@general_strike
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

Всеобщая забастовка остановила фашизм в 1920 году, и остановит его сейчас. [? if normalized_workers_total > 70 : Рабочие в полной мере поддерживают нас. ?][? if normalized_workers_total >= 50 and normalized_workers_total <= 70 : Несмотря на сомнения среди некоторых, в основном рабочие на нашей стороне. ?][? if normalized_workers_total > 30 and normalized_workers_total < 50 : Тем не менее, из-за сильного раздора в рабочем движении меньше половины профоюзов поддерживают нас. ?][? if normalized_workers_total <= 30 : Однако рабочие потеряли к нам доверие, и большинство из них не поддерживают нас. ?]


@loyal_police
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1
view-if: spd_prussia = 1

Так как мы всё ещё контролируем прусское правительство, мы можем попытаться призвать прусскую полицию на борьбу. [? if prussian_police_loyalty < 0.4 : К сожалению, она нас не поддерживает. ?][? if prussian_police_loyalty >= 0.4 and prussian_police_loyalty < 0.65 : Полиция разделена, и только около половины полицейских поддерживают нас. ?][? if prussian_police_loyalty >= 0.65 : Большинство полицейских вышло на борьбу за нас. Наша работа по повышению поддержки среди полиции оказалась не напрасной. ?]




@foreign_intervention
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1; 

# note: the Prussian coup should not trigger foreign intervention...


@war_outcome
view-if: war_choices >= 2
go-to: defeat if total_defeat = 1; long_war if long_war = 1; republic_victory if republic_victory = 1

@defeat

= Полное поражение

Наши силы не идут ни в какое сравнение реакционерам. Рейхсбаннер быстро разбит реакционным группировками СА и Штальхельма. Многи убиты, другие сдались. Оставшиеся лидеры партии сбежали или были казнены. Реакционеры захватили всю власть в Германии.

Наше сопротивление запомнят в истории, а наши имена запомнят навсегда. Но сейчас всё потеряно.

- @game_over: Игра окончена.

@long_war
go-to: long_war_intervention if resist_coup == 0; game_over_menu if resist_coup == 1

= Долгая война

Активная фаза войны заканчивается, и силы обеих сторон закрепляются на позициях.

Война разделяется на очерченные линии. Это будет не быстрым переворотом, но долгой граждаской войной. Нация уничтожит себя до того, как сможет быть восстановлена.

@game_over_menu

Несмотря на то, что мы можем призвать иностранные силы, остальные державы рассматривают прусский переворот как чисто внутренние дела Германии.

- @game_over

# no war

@long_war_intervention

- @west_aid: Возможно мы сможем получить помощь от западных стран.
- @soviet_aid: Perhaps we can receive aid from the Soviet Union.
- @east_aid: Perhaps our eastern neighbors, Poland and Czechoslovakia, can help us. If they know anything, they do not want fascists coming to power in Germany.
- @game_over: Game over.

@west_aid
choose-if: west_relation >= 2
unavailable-subtitle: Наши отношения недостаточно крепки.
on-arrival: west_aid += 1
max-visits: 1
go-to: long_war_intervention

Мы послали письма с просьбой о помощи в Великобританю и Францию, но их правительства разделены и не имеют единого мнения о нас. Нам нужно выживать самим до тех пор, пока они не примут решение.

@soviet_aid
choose-if: (soviet_relation >= 1 and kpd_relation >= 50) or (kpd_relation >= 75)
on-arrival: soviet_aid += 1
unavailable-subtitle: Наши отношения недостаточно крепки.
max-visits: 1
go-to: long_war_intervention

Мы послали письмо с просьбой о помощи в Советский Союз. КПГ получила поддержку, но Рейхсбаннер остался без вооружения. Если мы победим, то вряд ли сможем восстановить свой прежний авторитет.

@east_aid
choose-if: east_relation >= 2
on-arrival: east_aid += 1
unavailable-subtitle: Наши отношения недостаточно крепки.
max-visits: 1
go-to: long_war_intervention

Польша и Чехословакия в основном поглощены своими проблемами, но оружие и добровольцы всё ещё переправляются через части границы, которые мы контролируем.

@republic_victory

= Победа Республики

Наша линия обороны держится, а СА, Штальхельм и нелояльная часть Рейхсвера побеждены. Силы республики победили реакционеров и фашистов. Новая революция случилась в Германии. Понадеемся, что она принесёт процветание и стабильность в Германию.

- @game_over: Game over.

